# Copy this file to .env.local for running on your own computer.
# On Vercel, add these in Project → Settings → Environment Variables instead.

# Postgres connection string (Neon gives you this; it starts with postgres://)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Moni's password. Use a long one.
APP_PASSWORD=change-me-to-something-long

# haavaana's password (optional, must differ from APP_PASSWORD). Her data goes in a separate database.
APP_PASSWORD_2=a-different-long-password

# A random secret used to sign your login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-a-64-character-random-string-here
